# Source / build inputs (we ship the bundled dist/* only)
src/
tests/
scripts/

# Claude Code project state
.claude/

# Node toolchain (deps are bundled into dist/* via tsup)
node_modules/
package-lock.json

# Dev configs
tsconfig.json
tsup.config.ts
vitest.config.ts
.nvmrc
.npmignore
.gitignore

# CI
.github/

# Assets: ship only the PNG icon referenced by manifest.json — the SVG is
# just the source-of-truth for the website / README.
assets/*.svg

# Secrets and local files
*.env
creds.env
*.mcpb
coverage/
.tsbuildinfo
.DS_Store

# Sourcemaps (optional — Claude Desktop doesn't surface them)
dist/*.map
dist/*.d.ts

# server.js is the npm library entry (package.json "main") — Claude Desktop only loads dist/bin.js
dist/server.js

# Dev-facing docs (not useful inside the .mcpb to end users)
CLAUDE.md
